# Cloudflare Pages 응답 헤더
# data.json 은 07:30·16:05 하루 2회 갱신되므로 60초만 캐시하고 재검증한다.
/data.json
  Cache-Control: public, max-age=60, must-revalidate

# feeds.json 은 06:13·16:13 수집기가 유튜브 영상을 모아 갱신한다 — data.json 과 같은 60초.
/feeds.json
  Cache-Control: public, max-age=60, must-revalidate

/insights.json
  Cache-Control: public, max-age=60, must-revalidate

# styles.css·app.js 는 배포 직후 반영되도록 60초만 캐시한다.
# (기본값 14400초 = 4시간이라 디자인 수정이 브라우저에 늦게 떴다. index.html 에 ?v= 쿼리 버전을 붙여 함께 무효화한다.)
/styles.css
  Cache-Control: public, max-age=60, must-revalidate

/app.js
  Cache-Control: public, max-age=60, must-revalidate

# banner.png 는 블로그에 퍼간 이미지 — data.json 과 같은 주기로 다시 만들어지므로 60초만 캐시한다.
# (블로그 글에 박힌 이미지가 하루 종일 옛 요약으로 남지 않게.)
/banner.png
  Cache-Control: public, max-age=60, must-revalidate

# PWA 매니페스트·서비스 워커 — 배포 직후 설치 안내가 바뀌어도 바로 반영되게 짧게 캐시한다.
# (서비스 워커 스크립트 자체는 브라우저가 캐시를 우회해 갱신 여부를 확인한다.)
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=60, must-revalidate

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=60, must-revalidate

# 홈 화면 추가 아이콘 — 파일명이 고정이라 오래 캐시해도 된다. 디자인을 바꾸면 파일명과 함께 갱신한다.
/icons/*
  Cache-Control: public, max-age=604800
