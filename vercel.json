{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ipo-events-public.vercel.app"
        }
      ],
      "destination": "https://ipo.mydon.kr/:path*",
      "permanent": true
    }
  ]
}
